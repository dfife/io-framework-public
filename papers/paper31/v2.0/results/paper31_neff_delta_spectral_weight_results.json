  "theorem_31A": {
    "proof_identity": [
      "Z_1(q) = sum_n d_n q^{omega_n}",
      "if d_n -> c d_n, then Z_1 -> c Z_1",
      "ln Z(q) = sum_{m>=1} Z_1(q^m)/m, so ln Z -> c ln Z",
